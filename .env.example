# Public site origin used for auth redirects and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API).
# These are example values only — replace with your own project credentials.
# Never commit real secrets. .env.local is gitignored and is where local values belong.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose with NEXT_PUBLIC_.
# Keep this out of the repo entirely; provide it via .env.local or your host's env vars.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional authentication and invitation email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Custom session secret: generate at least 32 random bytes; never commit it.
AUTH_SESSION_SECRET=

# Private ES256 JWK imported into the chosen Supabase project's JWT signing keys.
# Keep JSON on one line in local/Vercel environment configuration.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KEY_ID=

# Optional only after an approved external rate-limit provider is selected.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Optional observability.
SENTRY_DSN=
